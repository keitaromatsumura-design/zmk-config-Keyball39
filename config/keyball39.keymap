#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// -----------------------------------------------------
// 日本語配列（JIS）記号の基本定義
// -----------------------------------------------------
// OS設定を日本語キーボードのまま使用するための変換定義

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }

// -----------------------------------------------------

#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    /* カスタム挙動 */

    behaviors {
        // ---- 🌟Zキー専用のMod-Tap（ここを追加しました）----

        mt_z: mod_tap_z {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_Z";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>; // Zキーの長押し判定時間（デフォルトより長め）
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        // QWRTレイヤー用のカンマ・ドット（JIS対応版）

        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LS(SLASH)>;

            // ? は Shift+/

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // ---- US配列エミュレート用 Mod-Morph ----

        jp_n2: jp_n2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp LBKT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        }; // 2 / @
        jp_n6: jp_n6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N6>, <&kp EQUAL>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        }; // 6 / ^
        jp_n7: jp_n7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp LS(N6)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        }; // 7 / &
        jp_n8: jp_n8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp LS(SQT)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        }; // 8 / *
        jp_n9: jp_n9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp LS(N8)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        }; // 9 / (
        jp_n0: jp_n0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&kp LS(N9)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        }; // 0 / )
        jp_minus: jp_minus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp LS(INT1)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        }; // - / _
        jp_semi: jp_semi {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp SQT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        }; // ; / :
        jp_equal: jp_equal {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(MINUS)>, <&kp LS(SEMI)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        }; // = / + // ' / "
    };

    /* マクロ */

    macros {
        Hiragana: Hiragana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "HIRAGANA";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&mt ESC Q     &kp W         &kp E     &kp R           &kp T                                     &kp Y        &kp U  &kp I   &kp O   &kp P
&kp A         &kp S         &kp D     &lt 4 F         &kp G                                     &kp H        &kp J  &kp K   &kp L   &kp BACKSPACE
&mt LSHIFT Z  &kp X         &kp C     &kp V           &kp B                                     &kp N        &kp M  &cmqus  &dtsmi  &kp MINUS
&kp RCTRL     &kp LEFT_WIN  &kp LALT  &lt 3 UP_ARROW  &lt 2 DOWN_ARROW  &lt 1 GRAVE  &kp ENTER  &lt 4 SPACE                         &mt RIGHT_SHIFT DELETE
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
&kp N1  &kp NUMBER_2  &kp N3     &kp N4        &kp N5                     &kp NUMBER_6    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&trans  &kp PLUS      &kp SLASH  &kp ASTERISK  &kp MINUS                  &kp UNDERSCORE  &kp LEFT      &kp UP_ARROW  &kp RIGHT     &trans
&trans  &trans        &trans     &jp_equal     &kp EQUAL                  &trans          &kp LEFT      &kp DOWN      &kp RIGHT     &trans
&trans  &trans        &trans     &trans        &trans     &trans  &trans  &trans                                                    &trans
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp EXCLAMATION  &kp AT    &kp HASH      &kp DOLLAR  &kp PERCENT                              &kp CARET     &kp AMPS           &kp ASTRK     &kp LPAR         &kp INTERNATIONAL_3
&kp EQUAL        &kp LBKT  &kp FSLH      &kp ASTRK   &kp MINUS                                &jp_semi      &kp SQT            &kp RBKT      &kp NON_US_HASH  &trans
&kp LS(EQUAL)    &kp AMPS  &kp QUESTION  &jp_equal   &kp LS(INTERNATIONAL_1)                  &kp LS(SEMI)  &kp DOUBLE_QUOTES  &kp LS(RBKT)  &kp LS(NUHS)     &trans
&trans           &trans    &trans        &trans      &trans                   &trans  &trans  &trans                                                          &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&kp F1  &kp F2          &kp F3        &kp F4     &kp F5                           &kp F6           &kp F7          &kp F8        &kp F9     &kp F10
&none   &kp LEFT_ARROW  &kp UP_ARROW  &kp RIGHT  &kp PG_UP                        &kp PRINTSCREEN  &kt LEFT        &kp UP_ARROW  &kp RIGHT  &trans
&none   &kp LEFT        &kp DOWN      &kp RIGHT  &kp PG_DN                        &none            &kp LEFT_ARROW  &kp DOWN      &kp RIGHT  &trans
&trans  &trans          &trans        &trans     &trans     &trans  &bt BT_SEL 1  &bt BT_SEL 2                                              &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&kp ESCAPE  &trans  &trans  &trans  &trans                  &jp_n6  &jp_n7     &jp_n8  &jp_n9     &jp_n0
&trans      &trans  &trans  &trans  &none                   &trans  &mkp LCLK  &mo 5   &mkp RCLK  &kp BACKSPACE
&kp LSHFT   &trans  &trans  &trans  &trans                  &trans  &none      &none   &none      &mkp MB4
&trans      &trans  &trans  &trans  &trans  &trans  &trans  &mo 4                                 &mkp MB5
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &bootloader                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans                          &trans
            >;
        };
    };
};
