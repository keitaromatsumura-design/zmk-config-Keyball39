#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/keys_jp.h>

#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    /* カスタム挙動の定義 */
    behaviors {
        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    /* マクロの定義 */
    macros {
        Hiragana: Hiragana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "HIRAGANA";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&mt ESC Q     &kp W         &kp E     &kp R           &kp T                                        &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A         &kp S         &kp D     &kp F           &kp G                                        &kp H        &kp J  &kp K      &kp L    &kp BACKSPACE
&mt LSHIFT Z  &kp X         &kp C     &kp V           &kp B                                        &kp N        &kp M  &cmqus     &dtsmi   &kp JP_MINUS
&kp RCTRL     &kp LEFT_WIN  &kp LALT  &lt 2 UP_ARROW  &lt 4 DOWN_ARROW  &lt 3 GRAVE     &kp ENTER  &lt 4 SPACE                             &mt RIGHT_SHIFT ENTER
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
&kp JP_N1  &kp JP_N2  &kp JP_N3  &kp JP_N4  &kp JP_N5                  &kp JP_N6  &kp JP_N7  &kp JP_N8  &kp JP_N9  &kp JP_N0
&kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &none                      &none      &none      &none      &none      &none
&none      &none      &none      &none      &none                      &none      &none      &trans     &trans     &none
&trans     &trans     &trans     &trans     &trans  &trans  &trans     &trans                                      &trans
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp JP_EXCL  &kp JP_AT    &kp JP_HASH  &kp JP_DLLR  &kp JP_PRCNT                &kp JP_CARET  &kp JP_AMPS  &kp JP_ASTRK  &kp JP_LPAR  &kp JP_RPAR
&trans       &trans       &trans       &trans       &trans                      &kp JP_MINUS  &kp JP_EQUAL &kp JP_LBKT   &kp JP_RBKT  &kp JP_SQT
&trans       &trans       &trans       &trans       &trans                      &kp JP_UNDER  &kp JP_PLUS  &trans        &trans       &kp JP_BSLH
&trans       &trans       &trans       &trans       &trans        &trans &trans &trans                                                &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&kp F1  &kp F2   &kp F3   &kp F4   &none                             &none     &none     &kp UP    &none  &none
&kp F5  &kp F6   &kp F7   &kp F8   &none                             &none     &kt LEFT  &none     &kp RIGHT  &none
&kp F9  &kp F10  &kp F11  &kp F12  &none                             &none     &none     &kp DOWN  &none  &trans
&trans  &trans   &trans   &trans   &trans  &trans  &bt BT_SEL 1  &bt BT_SEL 2                               &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&kp N1    &kp N2    &kp N3    &kp N4     &kp N5                   &kp N6    &kp N7    &kp N8  &kp N9    &kp N0
&kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &none                    &mkp MB5  &mkp LCLK &mo 5   &mkp RCLK &kp BACKSPACE
&kp LSHFT &trans    &trans    &trans     &trans                   &mkp MB4  &none     &none   &none     &none
&trans    &trans    &trans    &trans     &trans  &trans  &trans   &mo 4                                 &none
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &bootloader             &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };
    };
};
