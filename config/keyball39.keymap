#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// -----------------------------------------------------
// 日本語配列（JIS）記号の基本定義
// -----------------------------------------------------

#define JP_AT    LBKT      // @
#define JP_LPAR  LS(N8)    // (
#define JP_RPAR  LS(N9)    // )
#define JP_ASTRK LS(SQT)   // *
#define JP_PLUS  LS(SEMI)  // +
#define JP_MINUS MINUS     // -
#define JP_EQUAL LS(MINUS) // =
#define JP_EXCL  LS(N1)    // !
#define JP_HASH  LS(N3)    // #
#define JP_DLLR  LS(N4)    // $
#define JP_PRCNT LS(N5)    // %
#define JP_CARET EQUAL     // ^
#define JP_AMPS  LS(N6)    // &
#define JP_SQT   LS(N7)    // '
#define JP_LBKT  RBKT      // [
#define JP_RBKT  NUHS      // ]
#define JP_YEN   INT3      // ¥
#define JP_BSLH  INT1      // ろ (Backslash)
#define JP_UNDER LS(INT1)  // _ (Shift+ろ)
#define JP_DQT   LS(N2)    // "
#define JP_TILDE LS(EQUAL) // ~
#define JP_COLON SQT       // :
#define JP_PIPE  LS(INT3)  // |

// -----------------------------------------------------

#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    /* カスタム挙動 */

    behaviors {
        // QWRTレイヤー用のカンマ・ドット（JIS対応版）

        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LS(SLASH)>;
 // ? は Shift+/
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // ---- 🌟US配列エミュレート用 Mod-Morph（ここがキモです）----

        jp_n2: jp_n2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp LBKT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        }; // 2 / @
        jp_n6: jp_n6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N6>, <&kp EQUAL>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        }; // 6 / ^
        jp_n7: jp_n7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp LS(N6)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        }; // 7 / &
        jp_n8: jp_n8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp LS(SQT)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        }; // 8 / *
        jp_n9: jp_n9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp LS(N8)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        }; // 9 / (
        jp_n0: jp_n0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&kp LS(N9)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        }; // 0 / )
        jp_minus: jp_minus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp LS(INT1)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        }; // - / _
        jp_semi: jp_semi {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp SQT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        }; // ; / :
        jp_equal: jp_equal {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(MINUS)>, <&kp LS(SEMI)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        }; // = / +
        jp_sqt: jp_sqt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N7)>, <&kp LS(N2)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        }; // ' / "
    };

    /* マクロ */

    macros {
        Hiragana: Hiragana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "HIRAGANA";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&mt ESC Q     &kp W         &kp E     &kp R           &kp T                                        &kp Y        &kp U  &kp I   &kp O   &kp P
&kp A         &kp S         &lt 4 D   &kp F           &kp G                                        &kp H        &kp J  &kp K   &kp L   &kp BACKSPACE
&mt LSHIFT Z  &kp X         &kp C     &kp V           &kp B                                        &kp N        &kp M  &cmqus  &dtsmi  &kp ENTER
&kp RCTRL     &kp LEFT_WIN  &kp LALT  &lt 1 UP_ARROW  &lt 2 DOWN_ARROW  &lt 3 GRAVE  &kp UP_ARROW  &lt 4 SPACE                         &mt RIGHT_SHIFT DELETE
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
&kp N1  &kp NUMBER_2  &kp N3     &kp N4     &kp N5                     &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8          &kp NUMBER_9           &kp NUMBER_0
&trans  &kp PLUS      &kp SLASH  &kp PLUS   &kp MINUS                  &jp_semi      &kp JP_COLON  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &trans        &trans     &jp_equal  &kp MINUS                  &kp PLUS      &kp JP_ASTRK  &kp LS(COMMA)         &kp LS(PERIOD)         &trans
&trans  &trans        &trans     &trans     &trans     &trans  &trans  &trans                                                                   &trans
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp EXCLAMATION  &kp DOUBLE_QUOTES  &kp HASH      &kp DOLLAR  &kp PERCENT                  &kp AMPERSAND  &kp SQT       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp NON_US_BACKSLASH
&kp LCTRL        &kp AT_SIGN        &kt SLASH     &kp UNDER   &kp MINUS                    &jp_semi       &kp COLON     &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans
&kp TILDE        &kp SQT            &kp QUESTION  &kp EQUAL   &kp MINUS                    &kp PLUS       &kp ASTERISK  &kp LS(RBKT)          &kp LS(NUHS)           &trans
&trans           &trans             &trans        &trans      &trans       &trans  &trans  &trans                                                                    &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&kp F1  &kp F2          &kp F3        &kp F4     &kp F5                        &kp F6        &kp F7          &kp F8        &kp F9     &kp F10
&none   &kp LEFT_ARROW  &kp UP_ARROW  &kp RIGHT  &none                         &none         &kt LEFT        &kp UP_ARROW  &kp RIGHT  &none
&none   &kp LEFT        &kp DOWN      &kp RIGHT  &none                         &none         &kp LEFT_ARROW  &kp DOWN      &kp RIGHT  &trans
&trans  &trans          &trans        &trans     &trans  &trans  &bt BT_SEL 1  &bt BT_SEL 2                                           &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&kp N1     &jp_n2    &kp N3  &kp N4     &kp N5                  &jp_n6    &jp_n7     &jp_n8  &jp_n9     &jp_n0
&kp LEFT   &kp DOWN  &kp UP  &kp RIGHT  &none                   &mkp MB5  &mkp LCLK  &mo 5   &mkp RCLK  &kp BACKSPACE
&kp LSHFT  &trans    &trans  &trans     &trans                  &mkp MB4  &none      &none   &none      &none
&trans     &trans    &trans  &trans     &trans  &trans  &trans  &mo 4                                   &none
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &bootloader                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans                          &trans
            >;
        };
    };
};
